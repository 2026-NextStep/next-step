spring.application.name=backend
server.port=8080
spring.datasource.url=jdbc:mysql://localhost:3306/nextstep?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=YOUR_PASSWORD_HERE
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.orm.jdbc.bind=TRACE

# AI Server (FastAPI)
ai.fastapi.base-url=http://localhost:8000
# 채용공고 AI 분석·최신정보 맞춤 추천이 호출하는 AI 서버 주소 (기본값 http://localhost:8000)
ai.server.url=http://localhost:8000

# Frontend (메일 내 링크 생성용)
frontend.base-url=http://localhost:5173

# OpenAI
openai.api-key=YOUR_OPENAI_API_KEY

# JWT
jwt.secret=YOUR_JWT_SECRET_32CHARS_OR_MORE_HERE

# Email (Gmail SMTP)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_GMAIL_ADDRESS
spring.mail.password=YOUR_GMAIL_APP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Kakao OAuth
kakao.client-id=YOUR_KAKAO_REST_API_KEY
kakao.redirect-uri=http://localhost:5173/oauth/kakao/callback

# Gemini (자소서 AI 첨삭)
gemini.api-key=YOUR_GEMINI_API_KEY
gemini.model=gemini-3.6-flash

# 사용 횟수 제한 (선택 — 생략하면 아래 기본값으로 동작)
# AI 첨삭(회원당 하루), PDF 텍스트 추출(회원당 하루), 인증 메일(같은 이메일 재발송 간격·하루 횟수, 같은 IP 시간당 횟수)
#ratelimit.ai.per-day=30
#ratelimit.ocr.per-day=20
#ratelimit.email.cooldown-seconds=60
#ratelimit.email.per-day=5
#ratelimit.email.ip-per-hour=10
#email.verify.max-attempts=5
