OPENAI_API_KEY=your-openai-key-here

# Gemini (job_analysis, latest_info, contract 분석 전용)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROCESSOR_ID=your-processor-id
GCP_LOCATION=us

# 취업 정보 수집 (Tavily Search API)
TAVILY_API_KEY=your-tavily-api-key-here

# DB 접속 (latest_info 수집용)
DB_HOST=localhost
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=nextstep

# 수동 수집 API(/api/job-postings/sync, /api/latest-info/fetch) 호출용 관리자 키 (X-Admin-Key 헤더)
# 비워두면 localhost 요청만 허용 — 배포 시 반드시 설정
ADMIN_API_KEY=

# 최신정보 수집·맞춤 소식·공고 분석이 먼저 쓸 AI (gemini 기본 / openai)
# Gemini 무료 키를 자소서 AI Agent와 같이 쓰면 한도가 금방 차므로, 배포 서버에서는 openai 권장
LLM_PRIMARY=gemini
